<Project Sdk="Microsoft.NET.Sdk">

  <!-- Records tutorial clips from a YAML scenario with Playwright (installed by the mclip plugin). Keep it out of the
       app's solution: it is a tool, not the app, and names nothing of the app in its code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TutorialRecorder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Overlay\overlay.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tutorial.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
